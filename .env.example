# PaperLens needs no environment variables to run. Everything below is optional.

# GitHub token (no scopes needed) to raise GitHub API rate limits for the "Code" lookup.
# GITHUB_TOKEN=

# "owner/repo" whose GitHub Releases the /download page links to. Set this in a fork.
# NEXT_PUBLIC_GITHUB_REPO=Naveen-Sai-Ganadi/paperlens
